<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.CheckBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cadastropessoa.HelloController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>

        <TextField fx:id="txtNome" promptText="Nome"/>
        <TextField fx:id="txtIdade" promptText="Idade"/>

        <RadioButton fx:id="rbMasc" text="Masculino"/>
        <RadioButton fx:id="rbFem" text="Feminino"/>

        <CheckBox fx:id="chkEsportes" text="Gosta de praticar esportes"/>

        <Button fx:id="btnAnalisar" text="Analisar"/>

        <Label fx:id="lblResultado" text="Resultado:" wrapText="true"/>

    </children>
</VBox>
