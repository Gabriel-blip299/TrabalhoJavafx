<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.jogoadivinhacao.HelloController">
    <Label text="Jogo de Adivinhação" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Entrada do número -->
    <HBox spacing="10" alignment="CENTER">
        <Label text="Digite um número (1 a 10):"/>
        <TextField fx:id="txtNumero" prefWidth="80"/>
    </HBox>

    <!-- Botões -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Verificar" onAction="#verificar"/>
        <Button text="Tentar novamente" onAction="#novoNumero"/>
    </HBox>

    <!-- Resultado -->
    <Label fx:id="lblResultado" style="-fx-font-size: 14px; -fx-text-fill: #333;"/>
</VBox>
