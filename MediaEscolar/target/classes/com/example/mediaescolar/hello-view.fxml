<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.mediaescolar.HelloController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>

        <TextField fx:id="txtNome" promptText="Nome do aluno"/>

        <TextField fx:id="txtN1" promptText="Nota 1"/>
        <TextField fx:id="txtN2" promptText="Nota 2"/>
        <TextField fx:id="txtN3" promptText="Nota 3"/>

        <Button fx:id="btnCalcular" text="Calcular Média"/>

        <Label fx:id="lblResultado" text="Resultado:" wrapText="true"/>
    </children>

</VBox>
