<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.simuladorcontaluz.HelloController">

    <Label text="Simulador de Conta de Luz" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Nome do Cliente -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Nome do Cliente:"/>
        <TextField fx:id="txtNome" prefWidth="200"/>
    </HBox>

    <!-- Consumo -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Consumo (kWh):"/>
        <TextField fx:id="txtConsumo" prefWidth="100"/>
    </HBox>

    <!-- Tipo de residência -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Tipo de Residência:"/>
        <ComboBox fx:id="cbTipo" prefWidth="150"/>
    </HBox>

    <!-- Botão Calcular -->
    <Button text="Calcular" onAction="#calcular"/>

    <!-- Resultado -->
    <Label fx:id="lblResultado" style="-fx-font-size: 14px; -fx-text-fill: #333;"/>
</VBox>
